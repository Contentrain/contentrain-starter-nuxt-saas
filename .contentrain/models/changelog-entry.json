{
  "id": "changelog-entry",
  "kind": "document",
  "domain": "product",
  "i18n": true,
  "title_field": "title",
  "fields": {
    "release_date": {
      "required": true,
      "type": "date"
    },
    "slug": {
      "required": true,
      "type": "slug",
      "unique": true
    },
    "summary": {
      "type": "text"
    },
    "title": {
      "required": true,
      "type": "string"
    }
  }
}
